{
  "name": "tekxai-agent",
  "version": "1.1.0",
  "description": "TekXAI Desktop Agent — time tracking & screenshot monitoring",
  "main": "src/main.js",
  "author": {
    "name": "Tekxai LLC",
    "email": "support@tekxai.com"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.tekxaierp.app",
    "productName": "TEKxAI Agent",
    "icon": "assets/icon",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/build-tmp-napi-v6/**",
      "!**/*.{o,obj,Makefile}"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://releases.tekxai.services/desktop-app"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Tekxai LLC (64GRQF7C5Z)",
      "notarize": false
    },
    "afterSign": "scripts/notarize.js",
    "afterAllArtifactBuild": "scripts/staple-dmg.js",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "active-win": "^8.1.1",
    "axios": "^1.7.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "screenshot-desktop": "^1.15.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^43.3.0",
    "electron-builder": "^24.13.3"
  }
}
